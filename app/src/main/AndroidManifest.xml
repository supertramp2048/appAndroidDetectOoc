<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera.any" />

    <application
        android:name="com.socialapp.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SocialApp"
        tools:targetApi="31">

        <activity
            android:name="com.socialapp.feature.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.socialapp.feature.post.PostDetailActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.comments.CommentsActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.compose.ComposeActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.profile.ProfileActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.profile.UserListActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.settings.SettingsActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.factcheck.FactCheckHelperActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.auth.AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="reset-password"
                    android:scheme="socialapp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="socialapp" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.socialapp.feature.factcheck.MediaProjectionActivity"
            android:theme="@style/Theme.AppCompat.Translucent"
            android:exported="false" />

        <service
            android:name="com.socialapp.feature.factcheck.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|dataSync" />

        <activity
            android:name="com.socialapp.feature.factcheck.HistoryActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.factcheck.ResultActivity"
            android:theme="@style/Theme.SocialApp"
            android:exported="false" />

        <activity
            android:name="com.socialapp.feature.factcheck.ScreenshotCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:exported="false" />

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
    </application>

</manifest>
