<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/post_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="2dp">

        <!-- Top Row: Category Label & Author Avatar (NYT Editorial Header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/post_category_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:textColor="@color/app_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="THỜI SỰ" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.socialapp.core.ui.UserAvatarView
                android:id="@+id/post_author_avatar"
                android:layout_width="22dp"
                android:layout_height="22dp" />
        </LinearLayout>

        <!-- Main Editorial Row: Serif Headline (Left) & Thumbnail (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/post_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingExtra="3.5dp"
                android:maxLines="3"
                android:textColor="@color/app_text_primary"
                android:textSize="17.5sp"
                android:textStyle="bold"
                tools:text="Chính phủ ban hành nghị định mới về phát triển công nghệ cao và bảo vệ quyền lợi người tiêu dùng..." />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/post_thumbnail_card"
                android:layout_width="104dp"
                android:layout_height="78dp"
                android:layout_marginStart="14dp"
                android:visibility="gone"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/post_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh minh họa bài viết"
                    android:scaleType="centerCrop"
                    tools:src="@android:drawable/ic_menu_gallery" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Byline Row (Báo chí NYT: Tác giả & Thời gian) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/post_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/app_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Bởi Báo Tuổi Trẻ" />

            <TextView
                android:id="@+id/post_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#757575"
                android:textSize="12sp"
                tools:text="• 15 phút trước" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Interaction Metrics (Tối giản thanh lịch) -->
            <TextView
                android:id="@+id/post_vote_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="▲ 24" />

            <TextView
                android:id="@+id/post_comments_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/app_text_secondary"
                android:textSize="12sp"
                tools:text="💬 8" />
        </LinearLayout>

        <!-- Source Text (nếu có khác tác giả) -->
        <TextView
            android:id="@+id/post_source_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#888888"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Nguồn: Báo Tuổi Trẻ" />

        <!-- NYT Hairline Divider ngăn cách bài viết tiếp theo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/app_border" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
