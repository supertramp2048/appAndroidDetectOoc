<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <!-- Guest State -->
    <LinearLayout
        android:id="@+id/profile_guest_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="Bạn chưa đăng nhập.\nVui lòng đăng nhập để xem hồ sơ tác giả."
            android:textColor="#64748B"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_profile_guest_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_login"
            android:textAllCaps="true"
            android:textStyle="bold"
            app:backgroundTint="@color/app_primary"
            app:cornerRadius="4dp"
            app:elevation="0dp" />
    </LinearLayout>

    <!-- Logged-In Profile Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/profile_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/profile_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header: Minimal Editorial Avatar Header -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp">

                    <ImageView
                        android:id="@+id/profile_cover_image"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@color/app_surface_variant"
                        android:contentDescription="Ảnh bìa"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="top"
                        android:background="@color/app_border" />

                    <com.socialapp.core.ui.UserAvatarView
                        android:id="@+id/profile_avatar"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="bottom|center_horizontal"
                        app:strokeColor="@color/app_surface"
                        app:strokeWidth="3dp" />
                </FrameLayout>

                <!-- User Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp">

                    <!-- Author Name: Serif Bold (NYT Byline) -->
                    <TextView
                        android:id="@+id/profile_name_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textColor="@color/app_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Nguyễn Văn An" />

                    <!-- Email / Byline -->
                    <TextView
                        android:id="@+id/profile_email_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        tools:text="nguyenvanan@press.vn" />

                    <!-- Role Badge: Subtle 3dp Editorial Rectangle -->
                    <TextView
                        android:id="@+id/profile_role_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge_editorial"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textAllCaps="true"
                        android:textColor="@color/app_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="CÂY BÚT CHÍNH" />

                    <!-- Action Buttons: Subtle 4dp Rounded Corners -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_profile_settings"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Cài đặt"
                            android:textAllCaps="true"
                            android:textColor="@color/app_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/app_surface_variant"
                            app:cornerRadius="4dp"
                            app:elevation="0dp"
                            app:strokeColor="@color/app_border"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_profile_logout"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/action_logout"
                            android:textAllCaps="true"
                            android:textColor="@color/app_danger"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/app_surface"
                            app:cornerRadius="4dp"
                            app:elevation="0dp"
                            app:strokeColor="@color/app_border"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Email Verification Banner -->
                <com.socialapp.feature.auth.EmailVerificationBannerView
                    android:id="@+id/profile_email_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp" />

                <!-- Hairline Divider Above Stats -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/app_border" />

                <!-- Minimalist Flat Stats Bar (3 Columns separated by 1px hairlines) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/app_surface"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <!-- Stat 1: Posts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_posts_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="28" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="BÀI VIẾT"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/app_border" />

                    <!-- Stat 2: Followers -->
                    <LinearLayout
                        android:id="@+id/btn_open_followers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_followers_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="1.4K" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="THEO DÕI"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/app_border" />

                    <!-- Stat 3: Following -->
                    <LinearLayout
                        android:id="@+id/btn_open_following"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_following_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="120" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="ĐANG THEO"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hairline Divider Below Stats -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_border" />

                <!-- Section Header: Published Articles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="BÀI VIẾT ĐÃ XUẤT BẢN"
                        android:textAllCaps="true"
                        android:textColor="@color/app_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- User Posts List -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/profile_posts_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />

                    <com.socialapp.core.ui.LoadingSkeletonView
                        android:id="@+id/profile_loading_skeleton"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:visibility="gone" />

                    <com.socialapp.core.ui.ErrorStateView
                        android:id="@+id/profile_error_state"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:visibility="gone" />

                    <com.socialapp.core.ui.EmptyStateView
                        android:id="@+id/profile_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
