<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar (Editorial Minimalist) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/post_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_surface"
        app:navigationIcon="@drawable/ic_close_24">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_share_post"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chia sẻ"
                android:src="@drawable/ic_send_24" />

            <ImageButton
                android:id="@+id/btn_overflow_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tùy chọn"
                android:src="@drawable/ic_retake_24" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Toolbar bottom hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border" />

    <!-- Reading Progress Bar -->
    <ProgressBar
        android:id="@+id/reading_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/app_surface_variant"
        android:progressTint="@color/app_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/post_detail_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/post_detail_content_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="36dp">

                    <!-- Section / Category Tag (NYT uppercase topic) -->
                    <TextView
                        android:id="@+id/post_detail_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_neutral"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textAllCaps="true"
                        android:textColor="@color/app_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="Thời sự" />

                    <!-- Headline (Title - NYT Serif Bold) -->
                    <TextView
                        android:id="@+id/post_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/app_text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        tools:text="Tiêu đề chi tiết của bài viết tin tức mới nhất..." />

                    <!-- Byline Bar: Author, Date, Follow Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.socialapp.core.ui.UserAvatarView
                            android:id="@+id/post_detail_author_avatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/post_detail_author_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/app_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Tên Tác Giả" />

                            <TextView
                                android:id="@+id/post_detail_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="12sp"
                                tools:text="10:30 • 11/10/2026" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_follow_author"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="Theo dõi"
                            android:textColor="@color/app_primary"
                            android:textSize="12sp"
                            app:cornerRadius="18dp"
                            app:strokeColor="@color/app_primary"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- Hairline Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/app_border" />

                    <!-- Cover Thumbnail (Editorial Flat Lead Image) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/post_detail_thumbnail_card"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/app_border"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/post_detail_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Ảnh bài viết"
                            android:scaleType="centerCrop"
                            tools:src="@android:drawable/ic_menu_gallery" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Content WebView (Editorial Reading Experience) -->
                    <WebView
                        android:id="@+id/post_detail_web_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Source Text Attribution -->
                    <TextView
                        android:id="@+id/post_detail_source_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_source_item"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/app_primary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Nguồn: Báo Tuổi Trẻ (bấm để xem nguồn)" />

                    <!-- Hairline Divider (Top of Editorial Action Bar) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:background="@color/app_border" />

                    <!-- Minimalist Editorial Action Bar (Enlarged Proportions) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Upvote Flat Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_upvote"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="▲"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Vote Score -->
                        <TextView
                            android:id="@+id/post_detail_vote_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/app_text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            tools:text="3" />

                        <!-- Downvote Flat Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_downvote"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="▼"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Comments Flat Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_comments"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="💬 0 bình luận"
                            android:textColor="@color/app_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Fact Check Flat Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_factcheck"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="🔍 Kiểm chứng"
                            android:textColor="@color/app_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Hairline Divider (Bottom of Editorial Action Bar) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/app_border" />

                    <!-- Ad Slot -->
                    <com.socialapp.core.ui.AdSlotView
                        android:id="@+id/post_detail_ad_slot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.socialapp.core.ui.LoadingSkeletonView
            android:id="@+id/post_detail_loading_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.socialapp.core.ui.ErrorStateView
            android:id="@+id/post_detail_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
