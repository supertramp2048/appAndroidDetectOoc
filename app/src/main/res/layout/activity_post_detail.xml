<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar (Editorial Minimalist) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/post_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_surface"
        app:navigationIcon="@drawable/ic_close_24">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_share_post"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chia sẻ"
                android:src="@drawable/ic_send_24" />

            <ImageButton
                android:id="@+id/btn_overflow_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tùy chọn"
                android:src="@drawable/ic_retake_24" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Toolbar bottom hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border" />

    <!-- Reading Progress Bar -->
    <ProgressBar
        android:id="@+id/reading_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/app_surface_variant"
        android:progressTint="@color/app_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/post_detail_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/post_detail_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="32dp"
                android:scrollbars="vertical" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.socialapp.core.ui.LoadingSkeletonView
            android:id="@+id/post_detail_loading_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.socialapp.core.ui.ErrorStateView
            android:id="@+id/post_detail_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
