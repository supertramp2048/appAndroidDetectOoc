<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demoOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_demo_overlay"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Thanh tiêu đề tối giản (1 dòng gọn sạch) -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Nhãn cấu hình hiện tại (chạm trực tiếp để đổi nhanh) -->
        <TextView
            android:id="@+id/tvConfigBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_demo_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="P4 · 3G"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Nút Chạy / Dừng Replay -->
        <TextView
            android:id="@+id/btnReplayToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="Chạy"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Nút Xuất file CSV ra bên ngoài để đối chiếu -->
        <TextView
            android:id="@+id/btnCompare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="Xuất CSV"
            android:textColor="#E5E7EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Nút Cài đặt tối giản -->
        <TextView
            android:id="@+id/btnConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="Cài đặt"
            android:textColor="#E5E7EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Nút Thu gọn / Mở rộng -->
        <TextView
            android:id="@+id/btnToggleExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp"
            android:text="▾"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Phần thông tin tối giản (3 dòng rõ ràng, dễ nhìn khi trình chiếu) -->
    <LinearLayout
        android:id="@+id/containerExpandedDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="#26FFFFFF" />

        <!-- Dòng 1: Màn hiện tại -> Dự đoán Markov -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEED_NEWEST"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  →  Đoán: "
                android:textColor="#9CA3AF"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvPredictions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="POST_DETAIL (60%)"
                android:textColor="#F3F4F6"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng 2: Trạng thái bước vừa rồi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vừa mở: "
                android:textColor="#9CA3AF"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvLastHitStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL_HIT (0 ms)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng 3: Trạng thái Prefetch & Cache SWR + Glide (Ý 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrefetchActionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="⚡ Prefetch: Chờ tín hiệu dừng mắt..."
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng 4: Tín hiệu Dwell, Ảnh Glide, Độ tươi SWR & Ngân sách 4G (Ý 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRadioAndMediaStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="👁 Dwell: Post #1 | 🖼 Ảnh Glide: 0 | 🗄 Cache: 0 mục | 📶 4G Budget: 0/2048 KB"
                android:textColor="#A7F3D0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dòng 5: Tóm tắt Hit / Trễ TB / Lãng phí -->
        <TextView
            android:id="@+id/tvStatsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hit: 0.0% (0/0)  ·  Trễ TB: 0 ms  ·  Thừa: 0 KB"
            android:textColor="#D1D5DB"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
