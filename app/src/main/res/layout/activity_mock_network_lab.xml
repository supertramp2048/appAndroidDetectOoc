<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Clean White Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_network_lab"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="1dp"
        app:navigationIcon="@drawable/ic_close_24"
        app:title="Phòng Lab Mạng Giả Lập &amp; Prefetch"
        app:titleTextColor="#0F172A" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Switch Bật / Tắt giả lập -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_editorial"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bật Giả lập Trễ Mạng"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Áp dụng RTT và băng thông thực tế vào toàn bộ app"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_enable_simulation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Card 2: Chọn Network Profile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="1. CẤU HÌNH MẠNG (NETWORK PROFILES):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_editorial"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioGroup
                    android:id="@+id/radio_group_profiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radio_profile_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Wi-Fi (50 Mbps · RTT 15ms · 6,250 KB/s)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_profile_lte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:padding="8dp"
                        android:text="LTE 4G (20 Mbps · RTT 50ms · 2,500 KB/s)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_profile_3g"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="3G (2 Mbps · RTT 180ms · 250 KB/s)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_profile_edge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="EDGE 2G (160 Kbps · RTT 400ms · 20 KB/s)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Card 3: Chọn Payload Weight Multiplier -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="2. HỆ SỐ TẢI NẶNG PAYLOAD (WEIGHT MULTIPLIER):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_editorial"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioGroup
                    android:id="@+id/radio_group_weights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radio_weight_light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nhẹ (0.5x)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radio_weight_normal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Chuẩn (1.0x)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radio_weight_heavy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nặng (2.0x)"
                        android:textColor="#1E293B"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Card 4: Thử nghiệm nạp màn hình đơn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="3. THỬ NGHIỆM MẠNG THUẦN (TASK C1 &amp; C2):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_home"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="HOME (120KB)"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_post_detail"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="POSTDETAIL (250KB)"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_comments"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="COMMENTS (80KB)"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_profile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="PROFILE (60KB)"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Test Chia sẻ Băng thông đồng thời (Task C2) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_concurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2563EB"
                android:text="⚡ Nạp 2 Request Đồng Thời (Test Chia Sẻ Băng Thông N=2)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Card 5: Đồng hồ & Kết quả đo đạc Mạng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_editorial"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E2E8F0"
                        android:fontFamily="monospace"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="SẴN SÀNG"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_loading"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="10dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_latency_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="Độ trễ: 0 ms"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_breakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Phân rã: RTT: 0ms | Truyền tải: 0ms"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_payload_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Gói tin payload: 0 KB"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_bandwidth_concurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Băng thông chia sẻ: 0 KB/s (N = 1)"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_simulated_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Màn hình mô phỏng: --"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_log_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F1F5F9"
                    android:fontFamily="monospace"
                    android:padding="6dp"
                    android:text="Trạng thái: Sẵn sàng thử nghiệm"
                    android:textColor="#475569"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- SECTION 5: TASK C3 & C4 PREFETCHING & LATE HIT -->
            <!-- ============================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="4. CHÍNH SÁCH NẠP TRƯỚC (PREFETCH POLICIES):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_editorial"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioGroup
                    android:id="@+id/radio_group_policies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radio_policy_p0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="P0: Không nạp trước (Baseline đối chứng)"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_policy_p1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="P1: Nạp tất cả (Greedy Prefetch All)"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_policy_p2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:padding="6dp"
                        android:text="P2: Mặc định phổ biến nhất (Home -&gt; PostDetail)"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_policy_p3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="P3: Mô hình Markov Bậc 1 (Kiên - Ngưỡng θ = 0.5)"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_policy_p4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="P4: Mô hình Markov Bậc 2 (Chuỗi 2 bước + Backoff)"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <RadioButton
                        android:id="@+id/radio_policy_p5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="P5: Thích ứng chi phí mạng động (Pareto Utility)"
                        android:textColor="#1E293B"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="5. KIỂM THỬ LUỒNG PREFETCH &amp; LATE HIT (TASK C4):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Action buttons for Prefetch Flow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sim_visit_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#0F766E"
                    android:text="1. Mở HOME (Kích hoạt Âm Thầm Nạp Trước)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sim_acquire_post"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#4338CA"
                    android:text="2. Bấm vào POSTDETAIL (Kiểm tra FULL_HIT / LATE_HIT)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sim_cleanup_wasted"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="🗑️ Dọn dẹp Cache (Đo Lãng Phí)"
                        android:textAllCaps="false"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sim_reset_stats"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="🔄 Reset Thống Kê"
                        android:textAllCaps="false"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: Kết quả đo đạc Prefetch & Cache -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_input_editorial"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_prefetch_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E2E8F0"
                        android:fontFamily="monospace"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="SẴN SÀNG"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_prefetch_policy_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:text="[P2: Most Frequent]"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_prefetch_result_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="Thời gian chờ: 0 ms"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_prefetch_time_saved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Thời gian tiết kiệm: 0 ms"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:id="@+id/text_prefetch_hit_breakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Tỷ lệ Trúng: 0.0% | Full Hit: 0 | Late Hit: 0 | Miss: 0"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_prefetch_wasted_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Băng thông lãng phí (Wasted): 0.0 KB | Hữu ích: 0.0 KB"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_prefetch_cache_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="RAM Cache: 0 mục | Đang bay dở (In-flight): 0"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_prefetch_log_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F1F5F9"
                    android:fontFamily="monospace"
                    android:padding="6dp"
                    android:text="Nhật ký: Bấm (1) để bắt đầu nạp ngầm, sau đó bấm (2) để kiểm chứng Late Hit / Full Hit."
                    android:textColor="#475569"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
