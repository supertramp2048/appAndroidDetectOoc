<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comment_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Comment Main Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.socialapp.core.ui.UserAvatarView
            android:id="@+id/comment_author_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_surface"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Author Name & Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/comment_author_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Tên Tác Giả" />

                <TextView
                    android:id="@+id/comment_edited_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="(đã sửa)"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/comment_time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    tools:text="10 phút" />

                <ImageButton
                    android:id="@+id/btn_comment_menu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tùy chọn"
                    android:src="@drawable/ic_retake_24" />
            </LinearLayout>

            <!-- Comment Content -->
            <TextView
                android:id="@+id/comment_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Đây là nội dung bình luận mẫu..." />

            <!-- Removed Status Message -->
            <TextView
                android:id="@+id/comment_removed_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bình luận đã bị gỡ"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reply Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_reply_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="Trả lời"
            android:textColor="#1976D2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_load_replies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5E6B78"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Xem 2 phản hồi"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Expanded Replies Container -->
    <LinearLayout
        android:id="@+id/comment_replies_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
