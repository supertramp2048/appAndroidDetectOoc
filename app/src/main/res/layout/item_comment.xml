<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comment_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- Comment Main Body (Flat Editorial Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <com.socialapp.core.ui.UserAvatarView
            android:id="@+id/comment_author_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Author Name, Time & Menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/comment_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    tools:text="Tên Tác Giả" />

                <TextView
                    android:id="@+id/comment_time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11.5sp"
                    tools:text="• 10 phút trước" />

                <TextView
                    android:id="@+id/comment_edited_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif"
                    android:text="(đã sửa)"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_comment_menu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tùy chọn"
                    android:src="@drawable/ic_retake_24"
                    app:tint="@color/app_text_secondary" />
            </LinearLayout>

            <!-- Comment Content (Editorial Reading Legibility) -->
            <TextView
                android:id="@+id/comment_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                tools:text="Đây là nội dung bình luận mẫu theo phong cách báo chí The New York Times, rõ ràng, thoáng đãng và dễ đọc..." />

            <!-- Removed Status Message -->
            <TextView
                android:id="@+id/comment_removed_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Bình luận đã bị gỡ"
                android:textColor="@color/app_danger"
                android:textSize="12.5sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <!-- Reply Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_reply_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="2dp"
                    android:paddingEnd="14dp"
                    android:text="Trả lời"
                    android:textColor="@color/app_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_load_replies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="2dp"
                    android:textColor="@color/app_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Xem 2 phản hồi"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Expanded Replies Container -->
    <LinearLayout
        android:id="@+id/comment_replies_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Hairline Divider (Phân cách giữa các bình luận) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/app_border" />
</LinearLayout>
