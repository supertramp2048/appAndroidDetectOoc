<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar (Minimalist Editorial) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/comments_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_surface"
        app:navigationIcon="@drawable/ic_close_24"
        app:title="Bình luận"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <!-- Toolbar bottom hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border" />

    <!-- Comments List Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_surface">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/comments_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comments_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.socialapp.core.ui.LoadingSkeletonView
            android:id="@+id/comments_loading_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.socialapp.core.ui.ErrorStateView
            android:id="@+id/comments_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.socialapp.core.ui.EmptyStateView
            android:id="@+id/comments_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Replying-To Banner -->
    <LinearLayout
        android:id="@+id/replying_to_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/replying_to_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/app_primary"
            android:textSize="12.5sp"
            tools:text="Đang trả lời @Nguyễn Văn A" />

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hủy trả lời"
            android:src="@drawable/ic_close_24"
            app:tint="@color/app_text_secondary" />
    </LinearLayout>

    <!-- Hairline Divider above Input -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border" />

    <!-- Bottom Input Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Input Bar for Logged-In User -->
        <LinearLayout
            android:id="@+id/comment_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/comment_input_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_source_item"
                android:fontFamily="sans-serif"
                android:hint="Viết ý kiến thảo luận..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:maxLength="2000"
                android:maxLines="4"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_secondary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_send_comment"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Gửi bình luận"
                android:src="@drawable/ic_send_24"
                app:tint="@color/app_primary" />
        </LinearLayout>

        <!-- Guest Prompt for Non-Logged-In User -->
        <TextView
            android:id="@+id/comment_guest_prompt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_source_item"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Đăng nhập để tham gia thảo luận"
            android:textColor="@color/app_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
