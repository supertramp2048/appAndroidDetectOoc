<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/comments_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_surface"
        app:navigationIcon="@drawable/ic_close_24"
        app:title="Bình luận" />

    <!-- Comments List Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/comments_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comments_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.socialapp.core.ui.LoadingSkeletonView
            android:id="@+id/comments_loading_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.socialapp.core.ui.ErrorStateView
            android:id="@+id/comments_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.socialapp.core.ui.EmptyStateView
            android:id="@+id/comments_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Replying-To Banner -->
    <LinearLayout
        android:id="@+id/replying_to_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F4F8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/replying_to_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1976D2"
            android:textSize="12sp"
            tools:text="Đang trả lời @Nguyễn Văn A" />

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hủy trả lời"
            android:src="@drawable/ic_close_24" />
    </LinearLayout>

    <!-- Bottom Input Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:elevation="4dp"
        android:padding="8dp">

        <!-- Input Bar for Logged-In User -->
        <LinearLayout
            android:id="@+id/comment_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/comment_input_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_surface"
                android:hint="Viết bình luận..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:maxLength="2000"
                android:maxLines="4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_send_comment"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Gửi bình luận"
                android:src="@drawable/ic_send_24" />
        </LinearLayout>

        <!-- Guest Prompt for Non-Logged-In User -->
        <TextView
            android:id="@+id/comment_guest_prompt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_surface"
            android:gravity="center"
            android:text="Đăng nhập để bình luận"
            android:textColor="#1976D2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
