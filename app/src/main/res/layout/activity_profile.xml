<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar with hairline bottom border -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/profile_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_surface"
        app:navigationIcon="@drawable/ic_close_24"
        app:title="Hồ sơ tác giả"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6">

        <ImageButton
            android:id="@+id/btn_profile_overflow_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tùy chọn"
            android:src="@drawable/ic_retake_24" />
    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/profile_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/profile_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header: Minimal Editorial Avatar Header -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp">

                    <ImageView
                        android:id="@+id/profile_cover_image"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@color/app_surface_variant"
                        android:contentDescription="Ảnh bìa"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="top"
                        android:background="@color/app_border" />

                    <com.socialapp.core.ui.UserAvatarView
                        android:id="@+id/profile_avatar"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="bottom|center_horizontal"
                        app:strokeColor="@color/app_surface"
                        app:strokeWidth="3dp" />
                </FrameLayout>

                <!-- User Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp">

                    <!-- Author Name: Serif Bold -->
                    <TextView
                        android:id="@+id/profile_name_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textColor="@color/app_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Tên Tác Giả" />

                    <!-- Role Badge & Follow Action -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/profile_role_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_editorial"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textAllCaps="true"
                            android:textColor="@color/app_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="TÁC GIẢ" />
                    </LinearLayout>

                    <!-- Follow Button: Modern Editorial 4dp -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_follow_user"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:text="Theo dõi"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/app_primary"
                        app:cornerRadius="4dp"
                        app:elevation="0dp" />
                </LinearLayout>

                <!-- Hairline Divider Above Stats -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/app_border" />

                <!-- Minimalist Flat Stats Bar (3 Columns separated by 1px hairlines) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/app_surface"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <!-- Stat 1: Posts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_posts_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="BÀI VIẾT"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/app_border" />

                    <!-- Stat 2: Followers -->
                    <LinearLayout
                        android:id="@+id/btn_open_followers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_followers_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="THEO DÕI"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/app_border" />

                    <!-- Stat 3: Following -->
                    <LinearLayout
                        android:id="@+id/btn_open_following"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_following_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="ĐANG THEO"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hairline Divider Below Stats -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_border" />

                <!-- Section Header: Published Articles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="BÀI VIẾT ĐÃ XUẤT BẢN"
                        android:textAllCaps="true"
                        android:textColor="@color/app_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- User Posts List -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/profile_posts_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />

                    <com.socialapp.core.ui.LoadingSkeletonView
                        android:id="@+id/profile_loading_skeleton"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:visibility="gone" />

                    <com.socialapp.core.ui.ErrorStateView
                        android:id="@+id/profile_error_state"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:visibility="gone" />

                    <com.socialapp.core.ui.EmptyStateView
                        android:id="@+id/profile_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
