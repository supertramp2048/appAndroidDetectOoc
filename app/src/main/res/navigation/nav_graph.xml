<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.socialapp.feature.feed.FeedFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_feed" />

    <fragment
        android:id="@+id/nav_factcheck"
        android:name="com.socialapp.feature.factcheck.FactCheckTabFragment"
        android:label="@string/nav_factcheck"
        tools:layout="@layout/activity_main" />

    <fragment
        android:id="@+id/nav_search"
        android:name="com.socialapp.feature.feed.SearchFragment"
        android:label="@string/nav_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.socialapp.feature.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/view_empty_state" />
</navigation>
